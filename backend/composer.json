{
    "name": "mtg-sim/backend",
    "description": "Simulateur Magic: The Gathering à 3 joueurs IA avec points de bifurcation (fork)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "php": ">=8.3",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/string": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/stopwatch": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "smoke": "php bin/smoke.php"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    }
}
