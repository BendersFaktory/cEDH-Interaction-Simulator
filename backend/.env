# Valeurs par défaut (versionnées). Les surcharges locales vont dans .env.local (ignoré par git).
APP_ENV=dev
APP_SECRET=dev-secret-a-remplacer-hors-dev
# MySQL local. Le vrai mot de passe va dans .env.local (non versionné), jamais ici.
DATABASE_URL="mysql://mtgsim:CHANGEME@127.0.0.1:3306/mtg_sim?serverVersion=9.3.0&charset=utf8mb4"
DEFAULT_URI=http://localhost

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
